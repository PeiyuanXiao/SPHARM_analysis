# ==============================================================================
# 3D models & large binary data (hosted on OSF)
# ==============================================================================
*.stl
*.STL
*.ply
*.obj
*.las
*.laz
**/3D_models_cores/
**/3D_models_cores.zip

# ==============================================================================
# Generated data — all reproducible via tar_make()
# ==============================================================================
analysis/data/derived_data/
*.npy
*.npz
*.rds

# ==============================================================================
# targets cache — reproducible via tar_make()
# ==============================================================================
_targets/
analysis/paper/_targets/
analysis/robustness/_targets_store/
# Quarto/SI render log (generated artifact)
analysis/robustness/_si_render.log
# Robustness sensitivity — regenerated outputs (recomputed by the SI tar_make and
# read by nothing; the figures duplicate analysis/figures Fig S1-S5). The required
# INPUTS (spectra/ and scar_attrition*.csv) are intentionally NOT ignored.
analysis/robustness/*/figures/
analysis/robustness/*/sweep_manifest.csv
analysis/robustness/*/*_metrics.csv
analysis/robustness/*/*_orderselection_by_degree.csv
analysis/robustness/*/*_curves.csv
analysis/robustness/mesh_decimation_sensitivity/determinism_*.csv
analysis/robustness/scar_threshold_sensitivity/im_threshold_diagnostic.csv

# ==============================================================================
# Analysis output (figures, HTML, rendered docs)
# ==============================================================================
analysis/output/
*.html
*.docx
*.pdf
figure origin/
# keep the Word reference template (formatting, not a rendered output)
!analysis/templates/template.docx
!analysis/paper/manuscript.docx
!analysis/paper/manuscript.pdf

# ==============================================================================
# R / RStudio
# ==============================================================================
.Rhistory
.RData
.Rapp.history
.httr-oauth
# NOTE: keep this exactly as ".Rproj.user" (no trailing slash) — RStudio
# re-appends this exact line on every project open if it is not found verbatim.
.Rproj.user
renv/library/
renv/staging/
renv/python/

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ==============================================================================
# Root-level junk / temporary files
# ==============================================================================
.cache/
Rplots.pdf
Docker SPHARM start.txt
Start_SPHARM.bat

